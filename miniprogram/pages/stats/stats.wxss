.month-hero {margin:24rpx 28rpx;background:#234E70;color:#FCFDFE;border-radius:18rpx;padding:36rpx;}.hero-label {font-size:24rpx;color:#D5E6F3;}.hero-value {font-family:Georgia,serif;font-size:110rpx;line-height:1.3;margin-top:12rpx;word-break:break-all;}.hero-value text {font-family:"PingFang SC",sans-serif;font-size:26rpx;margin-left:16rpx;}.hero-caption {font-size:24rpx;color:#D5E6F3;}.hero-rule {height:1rpx;background:#587F9B;margin:28rpx 0;}.hero-footer {font-size:22rpx;color:#FFC6A8;}.stats-grid {display:flex;flex-wrap:wrap;padding:0 18rpx;}.stat-card {box-sizing:border-box;width:calc(50% - 20rpx);margin:10rpx;background:#FCFDFE;border:1rpx solid #D7E2EB;border-radius:14rpx;padding:26rpx;}.stat-index {font-size:18rpx;letter-spacing:2rpx;color:#65798B;}.stat-num {font-family:Georgia,serif;font-size:62rpx;color:#234E70;margin:18rpx 0 8rpx;word-break:break-all;}.stat-unit {font-family:"PingFang SC",sans-serif;font-size:20rpx;margin-left:8rpx;}.stat-label {font-size:23rpx;color:#65798B;}.tips {line-height:1.8;margin-bottom:40rpx;}.tips-title {font-size:26rpx;margin-bottom:12rpx;color:#234E70;}

.stat-index {letter-spacing:0;font-size:22rpx;}.month-hero {border-radius:24rpx;}.hero-value {font-size:96rpx;}.stat-card {border:none;border-radius:18rpx;}.hero-footer {color:#BCD1E1;}
