.month-hero {margin:24rpx 28rpx;background:#263746;color:#FFFFFF;border-radius:18rpx;padding:36rpx;}.hero-label {font-size:24rpx;color:#E5E9EC;}.hero-value {font-family:Georgia,serif;font-size:110rpx;line-height:1.3;margin-top:12rpx;word-break:break-all;}.hero-value text {font-family:"PingFang SC",sans-serif;font-size:26rpx;margin-left:16rpx;}.hero-caption {font-size:24rpx;color:#E5E9EC;}.hero-rule {height:1rpx;background:#5B6C77;margin:28rpx 0;}.hero-footer {font-size:22rpx;color:#D8BE96;}.stats-grid {display:flex;flex-wrap:wrap;padding:0 18rpx;}.stat-card {box-sizing:border-box;width:calc(50% - 20rpx);margin:10rpx;background:#FFFFFF;border:1rpx solid #E2E4E1;border-radius:14rpx;padding:26rpx;}.stat-index {font-size:18rpx;letter-spacing:2rpx;color:#747D83;}.stat-num {font-family:Georgia,serif;font-size:62rpx;color:#263746;margin:18rpx 0 8rpx;word-break:break-all;}.stat-unit {font-family:"PingFang SC",sans-serif;font-size:20rpx;margin-left:8rpx;}.stat-label {font-size:23rpx;color:#747D83;}.tips {line-height:1.8;margin-bottom:40rpx;}.tips-title {font-size:26rpx;margin-bottom:12rpx;color:#263746;}

.stat-index {letter-spacing:0;font-size:22rpx;}.month-hero {border-radius:24rpx;}.hero-value {font-size:96rpx;}.stat-card {border:none;border-radius:18rpx;}.hero-footer {color:#BFC9D1;}
