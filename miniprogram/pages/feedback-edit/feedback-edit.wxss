.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1efe8;
}

.form-row:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  color: #5f5e5a;
}

.fb-input {
  width: 100%;
  min-height: 240rpx;
  box-sizing: border-box;
}

.polish-btn {
  margin-top: 20rpx;
  background: #E0EBF3;
  color: #234E70;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.polish-btn::after {
  border: none;
}

.polish-hint {
  font-size: 22rpx;
  color: #9a988f;
  margin-top: 12rpx;
  line-height: 1.6;
}

.polished-tag {
  color: #234E70;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.polished-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.polished-head .polished-tag {
  margin-bottom: 0;
}

.regen-btn {
  font-size: 24rpx;
  color: #234E70;
  background: #E0EBF3;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.polished-text {
  line-height: 1.8;
  white-space: pre-wrap;
}

.save-btn {
  margin: 40rpx;
}

.fb-input {min-height:320rpx;line-height:1.8;background:repeating-linear-gradient(transparent,transparent 49rpx,#D7E2EB 50rpx);}.polish-btn {background:#234E70;color:#FCFDFE;line-height:80rpx;}.polish-hint {color:#65798B;}.polished-text {color:#334F65;}.polished-head {gap:12rpx;}
