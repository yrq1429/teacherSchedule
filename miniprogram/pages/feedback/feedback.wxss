.search-bar {
  padding: 24rpx 28rpx 8rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(35, 78, 112, 0.08);
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  color: #65798B;
  padding: 0 8rpx;
  font-size: 26rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx 8rpx;
  gap: 16rpx;
}

.filter-chip {
  font-size: 24rpx;
  color: #8a8378;
  background: #fff;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}

.filter-chip.active {
  background: #234E70;
  color: #fff;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(35, 78, 112, 0.3);
}

.filter-count {
  margin-left: auto;
}

.empty {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 90rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.card-hover {
  opacity: 0.75;
}

.fb-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.fb-course {
  font-weight: 500;
  font-size: 30rpx;
}

.fb-date {
  font-size: 22rpx;
  color: #65798B;
}

.fb-raw {
  line-height: 1.8;
  color: #5a5348;
  white-space: pre-wrap;
}

.fb-polished {
  background: #E5EFF6;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 16rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.polished-tag {
  color: #234E70;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.write-fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  background: #234E70;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 999rpx;
  padding: 22rpx 40rpx;
  box-shadow: 0 10rpx 24rpx rgba(35, 78, 112, 0.4);
}

page {padding-bottom:150rpx;}.search-box {border-radius:12rpx;box-shadow:none;border:1rpx solid #D7E2EB;background:#FCFDFE;}.filter-row {gap:10rpx;flex-wrap:wrap;}.filter-chip {padding:14rpx 24rpx;border-radius:8rpx;}.filter-count {font-size:20rpx;}.fb-card {border-top:4rpx solid #A6C0D4;}.fb-head {gap:16rpx;align-items:flex-start;}.fb-course {flex:1;word-break:break-all;}.fb-date {flex-shrink:0;color:#65798B;}.fb-raw {color:#334F65;}.fb-polished {border-radius:8rpx;border-left:3rpx solid #234E70;}.write-fab {border-radius:12rpx;bottom:calc(30rpx + env(safe-area-inset-bottom));box-shadow:0 8rpx 20rpx rgba(35,78,112,.15);}.polished-tag {color:#234E70;}
