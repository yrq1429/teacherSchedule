.tip {
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.picker-row {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}

.picker-chip {
  font-size: 26rpx;
  color: #263746;
  background: #ECEDEA;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
}

.file-btn {
  margin-top: 20rpx;
  font-size: 28rpx;
}

.file-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 12rpx 0;
}

.keyword-input {
  flex: 1;
  background: #F0F1ED;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
}

.file-hint {
  line-height: 1.6;
}

.example {
  background: #f2f4f8;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.raw-input {
  width: 100%;
  min-height: 280rpx;
  box-sizing: border-box;
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 20rpx;
}

.row-btns {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 20rpx;
}

.mini {
  font-size: 26rpx;
  line-height: 64rpx;
  padding: 0 36rpx;
  margin: 0;
  width: auto;
}

.row {
  display: flex;
  align-items: center;
}

.row-main {
  flex: 1;
}

.row-name {
  font-weight: 500;
  font-size: 30rpx;
  margin-bottom: 6rpx;
}

.row-del {
  color: #c0bdb4;
  padding: 10rpx 16rpx;
  font-size: 28rpx;
}

.import-btn {
  margin: 40rpx 60rpx;
}

.center-tip {
  text-align: center;
  padding: 24rpx 60rpx;
  line-height: 1.8;
}

.clear-link {
  text-align: center;
  color: #c05b4d;
  font-size: 24rpx;
  padding: 30rpx 0 60rpx;
}
