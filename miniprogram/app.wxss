page { background: #F6F5F1; color: #263746; font-size: 28rpx; font-family: "PingFang SC", sans-serif; }
.card { background: #FFFFFF; border: 1rpx solid #E8E9E5; border-radius: 14rpx; padding: 30rpx; margin: 20rpx 28rpx; }
.btn-primary, .btn-ghost { border-radius: 12rpx; font-size: 28rpx; font-weight: 500; line-height: 88rpx; }
.btn-primary { background: #263746; color: #FFFFFF; }
.btn-ghost { background: #ECEDEA; color: #263746; border: 1rpx solid #DADDD8; }
.btn-primary::after, .btn-ghost::after { border: none; }
.muted { color: #747D83; font-size: 24rpx; line-height: 1.65; }
.section-title { font-size: 32rpx; font-weight: 600; margin: 36rpx 32rpx 8rpx; }
.page-head { padding: 36rpx 32rpx 16rpx; }
.head-kicker { font-size: 20rpx; letter-spacing: 1rpx; color: #747D83; margin-bottom: 14rpx; }
.head-title { font-size: 44rpx; font-weight: 600; color: #263746; letter-spacing: 1rpx; }
.head-subtitle { font-size: 24rpx; color: #747D83; margin-top: 14rpx; line-height: 1.6; }
